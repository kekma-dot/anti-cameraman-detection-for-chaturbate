{
  "manifest_version": 3,
  "name": "Anti Cameraman Detection for Chaturbate",
  "version": "0.1.0",
  "description": "Blocks typing-notification POSTs sent by the messaging composer.",
  "permissions": [
    "declarativeNetRequest"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "typing-block",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
